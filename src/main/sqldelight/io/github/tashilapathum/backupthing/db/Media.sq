import io.github.tashilapathum.backupthing.classify.MediaKind;
import io.github.tashilapathum.backupthing.db.MediaStatus;

CREATE TABLE media_file (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    source_root TEXT NOT NULL,
    rel_path TEXT NOT NULL,
    kind TEXT AS MediaKind NOT NULL,
    src_size INTEGER NOT NULL,
    src_mtime INTEGER NOT NULL,
    status TEXT AS MediaStatus NOT NULL,
    out_rel_path TEXT,
    out_size INTEGER,
    out_sha256 TEXT,
    -- 1 when the original is uploaded (passthrough, motion photo as-is, compression did not help)
    upload_original INTEGER NOT NULL DEFAULT 0,
    backend TEXT,
    remote_path TEXT,
    error TEXT,
    attempts INTEGER NOT NULL DEFAULT 0,
    encode_ms INTEGER,
    uploaded_at INTEGER,
    updated_at INTEGER NOT NULL,
    UNIQUE (source_root, rel_path)
);

CREATE INDEX media_file_status ON media_file(status);

selectByPath:
SELECT * FROM media_file WHERE source_root = ? AND rel_path = ?;

selectById:
SELECT * FROM media_file WHERE id = ?;

selectByStatus:
SELECT * FROM media_file WHERE status = ? ORDER BY id;

insertNew:
INSERT INTO media_file (source_root, rel_path, kind, src_size, src_mtime, status, updated_at)
VALUES (?, ?, ?, ?, ?, 'NEW', ?);

requeueChanged:
UPDATE media_file
SET kind = ?, src_size = ?, src_mtime = ?, status = 'NEW', out_rel_path = NULL, out_size = NULL,
    out_sha256 = NULL, error = NULL, attempts = 0, encode_ms = NULL, uploaded_at = NULL, updated_at = ?
WHERE id = ?;

selectWork:
SELECT * FROM media_file WHERE status = ? ORDER BY kind, id;

markStatus:
UPDATE media_file SET status = ?, updated_at = ? WHERE id = ?;

markEncoded:
UPDATE media_file
SET status = 'ENCODED', out_rel_path = ?, out_size = ?, out_sha256 = ?, encode_ms = ?, backend = ?,
    upload_original = 0, error = NULL, updated_at = ?
WHERE id = ?;

markUseOriginal:
UPDATE media_file
SET status = 'ENCODED', out_rel_path = NULL, out_size = src_size, out_sha256 = NULL, encode_ms = ?,
    upload_original = 1, error = ?, updated_at = ?
WHERE id = ?;

markDone:
UPDATE media_file SET status = 'DONE', remote_path = ?, uploaded_at = ?, error = NULL, updated_at = ? WHERE id = ?;

-- Counts an attempt; the row returns to retryStatus, or FAILED once maxAttempts is reached.
recordFailure:
UPDATE media_file
SET attempts = attempts + 1, error = :error, updated_at = :now,
    status = CASE WHEN attempts + 1 >= :maxAttempts THEN 'FAILED' ELSE :retryStatus END
WHERE id = :id;

markFailed:
UPDATE media_file SET status = 'FAILED', attempts = attempts + 1, error = ?, updated_at = ? WHERE id = ?;

-- Without counting an attempt (e.g. login required, or a staged file went missing).
revert:
UPDATE media_file SET status = ?, error = ?, updated_at = ? WHERE id = ?;

recoverInterrupted:
UPDATE media_file
SET status = CASE status WHEN 'ENCODING' THEN 'NEW' ELSE 'ENCODED' END, updated_at = ?
WHERE status IN ('ENCODING', 'UPLOADING');

retryFailed:
UPDATE media_file SET status = 'NEW', attempts = 0, error = NULL, updated_at = ? WHERE status = 'FAILED';

retryOne:
UPDATE media_file SET status = 'NEW', attempts = 0, error = NULL, updated_at = ? WHERE id = ? AND status = 'FAILED';

countByStatus:
SELECT status, COUNT(*) AS files, SUM(src_size) AS src_bytes, CAST(COALESCE(SUM(out_size), 0) AS INTEGER) AS out_bytes
FROM media_file GROUP BY status;

CREATE TABLE run (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    started_at INTEGER NOT NULL,
    finished_at INTEGER,
    trigger TEXT NOT NULL,
    status TEXT NOT NULL,
    files_done INTEGER NOT NULL DEFAULT 0,
    files_failed INTEGER NOT NULL DEFAULT 0,
    bytes_in INTEGER NOT NULL DEFAULT 0,
    bytes_out INTEGER NOT NULL DEFAULT 0,
    message TEXT
);

insertRun:
INSERT INTO run (started_at, trigger, status) VALUES (?, ?, 'RUNNING');

lastInsertId:
SELECT last_insert_rowid();

finishRun:
UPDATE run SET finished_at = ?, status = ?, files_done = ?, files_failed = ?, bytes_in = ?, bytes_out = ?, message = ?
WHERE id = ?;

lastRunStart:
SELECT MAX(started_at) AS started FROM run;

recentFailed:
SELECT * FROM media_file WHERE status = 'FAILED' ORDER BY updated_at DESC LIMIT ?;

deleteAllMedia:
DELETE FROM media_file;

deleteAllRuns:
DELETE FROM run;

recentSources:
SELECT source_root, rel_path, kind FROM media_file WHERE kind != 'PASSTHROUGH' ORDER BY src_mtime DESC LIMIT ?;

recentRuns:
SELECT * FROM run ORDER BY id DESC LIMIT ?;

-- Bytes uploaded per local day (yyyy-MM-dd), for the upload caps. Kept when the media history is reset.
CREATE TABLE upload_usage (
    day TEXT NOT NULL PRIMARY KEY,
    bytes INTEGER NOT NULL DEFAULT 0
);

insertUsageDay:
INSERT OR IGNORE INTO upload_usage (day, bytes) VALUES (?, 0);

addUsage:
UPDATE upload_usage SET bytes = bytes + ? WHERE day = ?;

-- Days are ISO dates, so string order is date order.
usageBetween:
SELECT CAST(COALESCE(SUM(bytes), 0) AS INTEGER) AS bytes FROM upload_usage WHERE day >= ? AND day < ?;
